{
    auto_https off
}

:80 {
    encode zstd gzip

    # Facebook calls this signed webhook. The adapter is isolated from the web app.
    @facebook_webhook path /facebook/webhook
    handle @facebook_webhook {
        reverse_proxy friday-facebook:8781
    }

    @api path /api/*
    handle @api {
        uri strip_prefix /api
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:3000
    }
}
